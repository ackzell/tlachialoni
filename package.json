{
  "name": "tlachialoni",
  "version": "0.1.3",
  "private": true,
  "description": "A chromeless localhost browser with docked Chromium DevTools",
  "author": {
    "name": "ackzell",
    "url": "https://ackzell.dev"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --mac",
    "package:mac": "electron-builder --mac",
    "tag:first": "commit-and-tag-version --first-release -- --no-verify",
    "tag": "commit-and-tag-version -- --no-verify",
    "tag:minor": "commit-and-tag-version --release-as minor -- --no-verify",
    "tag:major": "commit-and-tag-version --release-as major -- --no-verify",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:preload": "tsc --noEmit -p tsconfig.preload.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:preload && npm run typecheck:web",
    "test": "vp test",
    "check": "vp check",
    "check:fix": "vp check --fix"
  },
  "dependencies": {
    "@fontsource-variable/source-code-pro": "^5.3.0",
    "@vueuse/core": "^15.0.0",
    "fflate": "^0.8.3",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "commit-and-tag-version": "^13.2.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plus": "^1.0.0-rc.0",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron@44.4.5": true
  },
  "productName": "Tlachialoni"
}
